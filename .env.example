# ---------- Database ----------
# Port 5433 (not 5432) to avoid clashing with other local Postgres containers.
DATABASE_URL="postgresql://masbah:masbah@localhost:5433/masbah_crm?schema=public"

# ---------- Authentication ----------
NEXTAUTH_URL="http://localhost:3100"
AUTH_URL="http://localhost:3100"
AUTH_SECRET="change-me-run-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- AI ----------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ---------- Integrations (optional / future phases) ----------
GOOGLE_MAPS_API_KEY=""
META_APP_ID=""
META_APP_SECRET=""
WHATSAPP_BUSINESS_ID=""
WHATSAPP_ACCESS_TOKEN=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# ---------- Webhooks (n8n) ----------
# Shared secret for inbound webhook calls: send as `x-api-key`.
WEBHOOK_API_KEY="masbah-dev-webhook-key"

# ---------- App ----------
APP_NAME="Masbah.ma"
APP_URL="http://localhost:3100"
